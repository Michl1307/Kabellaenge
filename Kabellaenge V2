<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kabellängen Rechner</title>

<style>
body{
    font-family: Arial, sans-serif;
    margin:20px;
    background:#f5f5f5;
}

.card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 2px 8px rgba(0,0,0,0.1);
    margin-bottom:20px;
}

input, select, button{
    width:100%;
    padding:12px;
    margin-top:8px;
    margin-bottom:15px;
    border-radius:8px;
    border:1px solid #ccc;
    box-sizing:border-box;
}

button{
    background:#007aff;
    color:white;
    border:none;
    font-size:16px;
}

button:hover{
    background:#005ecb;
}

.result{
    font-size:24px;
    font-weight:bold;
    color:#007aff;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ddd;
    padding:8px;
    text-align:left;
}

th{
    background:#007aff;
    color:white;
}
</style>
</head>
<body>

<div class="card">
    <h2>Kabellängen Rechner</h2>

    <label>Kabeltyp</label>
    <select id="kabeltyp">
        <option value="Kupfer|1.5">NYM-J 3x1,5</option>
        <option value="Kupfer|2.5">NYM-J 3x2,5</option>
        <option value="Kupfer|4">NYM-J 3x4</option>
        <option value="Kupfer|6">H07V-K 6</option>
        <option value="Kupfer|10">H07V-K 10</option>
        <option value="Aluminium|16">Aluminium 16</option>
    </select>

    <label>Widerstand Ω</label>
    <input type="number" step="0.001" id="widerstand">

    <button onclick="berechnen()">Länge berechnen</button>

    <div class="result" id="ergebnis">0 m</div>
</div>

<div class="card">
    <h3>Gespeicherte Messungen</h3>

    <table>
        <thead>
            <tr>
                <th>Kabel</th>
                <th>Ω</th>
                <th>Länge m</th>
                <th>Aktion</th>
            </tr>
        </thead>
        <tbody id="liste">
        </tbody>
    </table>
</div>

<script>

const rho = {
    "Kupfer": 0.0178,
    "Aluminium": 0.0282
};

function berechnen(){

    const auswahl = document.getElementById("kabeltyp").value.split("|");

    const material = auswahl[0];
    const querschnitt = parseFloat(auswahl[1]);

    const widerstand = parseFloat(
        document.getElementById("widerstand").value
    );

    if(isNaN(widerstand)){
        alert("Bitte Widerstand eingeben");
        return;
    }

    // Für Leitungen mit Hin- und Rückleiter:
    // Gesamtwiderstand = R * (L / A) * 2
    // => L = (R * A) / (rho * 2)
    const laenge = (widerstand * querschnitt) / (rho[material] * 2);

    document.getElementById("ergebnis").textContent =
        laenge.toFixed(2) + " m";

    const messung = {
        kabel: document.getElementById("kabeltyp").options[
            document.getElementById("kabeltyp").selectedIndex
        ].text,
        widerstand: widerstand,
        laenge: laenge.toFixed(2)
    };

    let daten = JSON.parse(
        localStorage.getItem("messungen") || "[]"
    );

    daten.push(messung);

    localStorage.setItem(
        "messungen",
        JSON.stringify(daten)
    );

    anzeigen();
}

function anzeigen(){

    let daten = JSON.parse(
        localStorage.getItem("messungen") || "[]"
    );

    let html = "";

    daten.forEach((e,index) => {

        html += `
        <tr>
            <td>${e.kabel}</td>
            <td>${e.widerstand}</td>
            <td>${e.laenge}</td>
            <td>
                <button onclick="loeschen(${index})"
                        style="background:red;padding:8px;">
                    Löschen
                </button>
            </td>
        </tr>
        `;
    });

    document.getElementById("liste").innerHTML = html;
}

function loeschen(index){

    let daten = JSON.parse(
        localStorage.getItem("messungen") || "[]"
    );

    daten.splice(index,1);

    localStorage.setItem(
        "messungen",
        JSON.stringify(daten)
    );

    anzeigen();
}

anzeigen();

</script>

</body>
</html>
